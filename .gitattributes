# Consistent line endings keep cross-platform edits focused on source changes.
* text=auto eol=lf

# Media stays binary; merging code always uses Git's normal conflict detection.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
