{
  "name": "ironwake",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write \"dist/**/*.{js,css}\" \"worker/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.test.js\"",
    "format:check": "prettier --check \"dist/**/*.{js,css}\" \"worker/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.test.js\"",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:report": "node scripts/check-architecture.mjs --report",
    "test": "node --test tests/*.test.js",
    "build:info": "node scripts/build-info.mjs",
    "version": "node scripts/build-info.mjs",
    "preview": "node scripts/preview-server.mjs",
    "predev": "node scripts/build-info.mjs",
    "dev": "wrangler dev --port 4174",
    "prebuild": "node scripts/build-info.mjs",
    "build": "wrangler deploy --dry-run --outdir build",
    "predeploy": "node scripts/build-info.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "wrangler": "4.151.1"
  }
}
